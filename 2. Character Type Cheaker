#include<stdio.h>
int main()
{
    char ch;
    printf("Enter Your Character:\n");
    scanf("%c",&ch);
    if(ch>='A'&&ch<='Z')
    {
        printf("%c is Uppercase Letter",ch);
    }
    else if(ch>='a'&&ch<='z')
    {
        printf("%c is Lowercase Letter",ch);
    }
    else if(ch>='0'&&ch<='9')
    {
        printf("%c is Digit Letter",ch);
    }
    else
    {
        printf("%c is Special Character",ch);
    }
}
