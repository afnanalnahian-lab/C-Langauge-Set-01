#include <stdio.h>

int main() {
    int num, i;
    int count = 0; 

    printf("Enter a number: ");
    scanf("%d", &num);

    for (i = 1; i <= num; i++) 
    {
        if (num % i == 0) 
        {
            count++; 
        }
    }
    //moulik songkha k 2 ta songkha dara vag kora jay...(nije and one)
    if (count == 2) 
    {
        printf("Prime number.\n");
    } 
    else 
    {
        printf("Not a prime number.\n");
    }

    return 0;
}
