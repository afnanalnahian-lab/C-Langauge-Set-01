#include<stdio.h>
int main()
{
    int n;
    
    printf("Enter Your Number:\n");
    scanf("%d",&n);
    
    if(n>80)
    {
        printf("%d Number is Grade:A",n);
    }
    else if(n>=70&&n<=79)
    {
        printf("%d Number is Grade:B",n);
    }
    else if(n>=60&&n<=69)
    {
        printf("%d Number is Grade:C",n);
    }
    else if(n>=50&&n<=59)
    {
        printf("%d Number is Grade:D",n);
    }
    else
    {
        printf("You are Fail");
    }
}
