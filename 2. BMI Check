#include<stdio.h>
int main()
{
    int h,w;
    float bmi;

    printf("Enter Your Height:\n");
    scanf("%d",&h);
    printf("Enter Your Weight:\n");
    scanf("%d",&w);

    bmi=w/(h*h);

    if(bmi<18.5)
    {
        printf("Underweight");
    }
    else if(bmi>=18.5&&bmi<=24.9)
    {
        printf("Normal");
    }
    else if(bmi>=25&&bmi<=29.9)
    {
        printf("Overweight");
    }
    else
    {
        printf("Obese");
    }
}
